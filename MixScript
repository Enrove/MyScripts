local function removeESP(target)
	local h = highlights[target]
	if h then
		h:Destroy()
		highlights[target] = nil
	end
end

local function applyESP(target, character)
	removeESP(target)
	local h = Instance.new("Highlight")
	h.Name = "PlayerESP"
	h.FillColor = Color3.fromRGB(255, 60, 60)
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.8
	h.Enabled = State.ESP
	h.Adornee = character
	h.Parent = character
	highlights[target] = h
end

local function trackPlayer(target)
	if target == player then return end
	if target.Character then
		applyESP(target, target.Character)
	end
	connect(target.CharacterAdded, function(character)
		applyESP(target, character)
	end)
end

