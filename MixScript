do
	local MIN = Vector2.new(440, 300)
	local MAX = Vector2.new(900, 620)

	local grip = new("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -4, 1, -4),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "◢",
		TextColor3 = THEME.sub,
		TextSize = 16,
		Font = Enum.Font.GothamBold,
		ZIndex = 5,
		Parent = main,
	})

	local resizing, startMouse, startSize, startPos
	connect(grip.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			startMouse = input.Position
			startSize = main.AbsoluteSize
			startPos = main.Position
		end
	end)
	connect(UserInputService.InputChanged, function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startMouse
			local w = math.clamp(startSize.X + delta.X, MIN.X, MAX.X)
			local h = math.clamp(startSize.Y + delta.Y, MIN.Y, MAX.Y)
			main.Size = UDim2.fromOffset(w, h)
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + (w - startSize.X) / 2,
				startPos.Y.Scale, startPos.Y.Offset + (h - startSize.Y) / 2
			)
		end
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)
end
