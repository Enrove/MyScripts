local function getTargetParts(model)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return {} end

	local parts = {}

	if AimPartMode == "Head" or AimPartMode == "Both" then
		local head = model:FindFirstChild("Head")
		if head then table.insert(parts, head) end
	end

	if AimPartMode == "Body" or AimPartMode == "Both" then
		local body = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
		if body then table.insert(parts, body) end
	end

	return parts
end

local function getClosestTarget(camera)
	local viewport = camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local bestPart, bestDist = nil, Values.FOVSize

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local parts = getTargetParts(plr.Character)
			for _, part in ipairs(parts) do
				local pos, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
					if dist < bestDist then
						bestPart = part
						bestDist = dist
					end
				end
			end
		end
	end
	return bestPart
end

RunService:BindToRenderStep("BaeginHubAim", Enum.RenderPriority.Camera.Value + 1, function()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local viewport = camera.ViewportSize
	circle.Position = UDim2.fromOffset(viewport.X / 2, viewport.Y / 2)

	if not State.Aimbot then return end
	if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

	local part = getClosestTarget(camera)
	if part then
		local goal = CFrame.lookAt(camera.CFrame.Position, part.Position)
		camera.CFrame = camera.CFrame:Lerp(goal, Values.Smooth / 100)
	end
end)


