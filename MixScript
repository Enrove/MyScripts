local function selectTab(name)
	for n, page in pairs(pages) do
		page.Visible = (n == name)
	end
	for n, tab in pairs(tabButtons) do
		local active = (n == name)
		tween(tab.button, FAST, { BackgroundTransparency = active and 0 or 1 })
		tween(tab.bar, FAST, { BackgroundTransparency = active and 0 or 1 })
		tween(tab.label, FAST, { TextColor3 = active and THEME.text or THEME.sub })
	end
end

